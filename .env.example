# Environment - development | production
# Store / release native builds MUST use production + real IAP/ads providers.
# `npm run build:android|ios` runs game:verify-config, which when VITE_APP_ENV=production requires:
#   revenuecat + both RevenueCat API keys, admob + real app/unit ids (rejects Google sample ids).
# apply-*-native only allows Google sample AdMob app ids when VITE_APP_ENV!=production.
# Vite production native bundles also block mock IAP/ads at runtime even if this is left as development.
VITE_APP_ENV="development"

# Game config - must match backend GameId enum
VITE_GAME_ID="MEMORA"

# Shared with game-api `API_KEY`. Embedded in the client bundle (extractable).
VITE_API_KEY="change-me"

# IAP provider: mock | revenuecat
VITE_IAP_PROVIDER="mock"
# RevenueCat API keys - required when VITE_IAP_PROVIDER=revenuecat
# VITE_REVENUECAT_IOS_API_KEY=""
# VITE_REVENUECAT_ANDROID_API_KEY=""

# Ads provider: mock | admob
VITE_ADS_PROVIDER="mock"
# iOS - required when VITE_ADS_PROVIDER=admob
# VITE_ADMOB_IOS_APP_ID=""
# Optional
# VITE_ADMOB_IOS_BANNER_ID=""
# VITE_ADMOB_IOS_REWARDED_ID=""
# VITE_ADMOB_IOS_INTERSTITIAL_ID=""
# Android - required when VITE_ADS_PROVIDER=admob
# VITE_ADMOB_ANDROID_APP_ID=""
# Optional
# VITE_ADMOB_ANDROID_BANNER_ID=""
# VITE_ADMOB_ANDROID_REWARDED_ID=""
# VITE_ADMOB_ANDROID_INTERSTITIAL_ID=""

# Store listing (share + in-app rate fallback to Play Store / App Store)
VITE_IOS_APP_STORE_ID=""
VITE_ANDROID_PACKAGE_ID="com.vraxion.memora"

# Analytics provider: console | firebase
VITE_ANALYTICS_PROVIDER="console"
# Firebase — required when VITE_ANALYTICS_PROVIDER=firebase.
# Also required for native push: notification-env.json sets pushNotificationsEnabled=true for both
# `development` and `production`; without these vars, push stays disabled at runtime on native.
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_MEASUREMENT_ID=""
# Native FCM also needs google-services.json / GoogleService-Info.plist under native/firebase/
# (copy from the .example files — see documents/setup/firebase-native.md).
